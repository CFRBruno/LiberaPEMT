rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPcm() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pcm';
    }
    // Qualquer usuário logado lê; só PCM escreve (equipamentos, snapshots, usuários).
    match /{col}/{id} {
      allow read: if request.auth != null;
      allow write: if isPcm();
    }
  }
}
